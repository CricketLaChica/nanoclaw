# Timezone for all date/time operations (cron, logs, scheduled tasks)
# Pacific/Honolulu = HST = UTC-10 (no daylight saving time)
TZ=Pacific/Honolulu

# WebSocket auth token (must match webOS VITE_OPENCLAW_TOKEN)
WEBSOCKET_AUTH_TOKEN=nano-claw-web-secret-change-me

# Container timeout - how long a container can run before being killed
# Default was 30 min (1800000ms), now set to 12 hours (43200000ms)
# Set to 0 to disable timeout entirely (not recommended)
CONTAINER_TIMEOUT=43200000

# Idle timeout - how long to wait with no output before closing container stdin
# Default was 30 min (1800000ms), now set to 2 hours (7200000ms)
IDLE_TIMEOUT=7200000
