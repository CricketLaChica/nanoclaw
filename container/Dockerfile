# NanoClaw Agent Container
# Runs Claude Agent SDK in isolated Linux VM with browser automation

FROM node:22-slim

# Install system dependencies for Chromium and timezone data
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-liberation \
    fonts-noto-color-emoji \
    libgbm1 \
    libnss3 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libasound2 \
    libpangocairo-1.0-0 \
    libcups2 \
    libdrm2 \
    libxshmfence1 \
    curl \
    git \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set timezone to Pacific/Honolulu (HST = UTC-10, no DST)
# This ensures cron expressions and date operations use Hawaii time
ENV TZ=Pacific/Honolulu
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Set Chromium path for agent-browser
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Install agent-browser and claude-code globally
RUN npm install -g agent-browser @anthropic-ai/claude-code

# Create wrapper script to force ANTHROPIC_BASE_URL
RUN mv /usr/local/bin/claude /usr/local/bin/claude-original && \
    printf '#!/bin/bash\nexport ANTHROPIC_BASE_URL=http://host.docker.internal:8787\nexec /usr/local/bin/claude-original "$@"\n' > /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude

# Create app directory
WORKDIR /app

# Copy package files first for better caching
COPY agent-runner/package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY agent-runner/ ./

# Build TypeScript
RUN npm run build

# Create workspace directories
RUN mkdir -p /workspace/group /workspace/global /workspace/extra /workspace/ipc/messages /workspace/ipc/tasks /workspace/ipc/input

# Create start_task binary for background task management
RUN printf '#!/bin/bash\n# start_task: Start a long-running background task\n# Usage: start_task <agent> "<task-name>" "<prompt>"\n\nif [ $# -lt 3 ]; then\n  echo "Usage: start_task <agent> <task-name> <prompt>"\n  echo "Example: start_task nalu \"Build Blog\" \"Create a NextJS blog project\""\n  exit 1\nfi\n\nAGENT="$1"\nTASK_NAME="$2"\nPROMPT="$3"\n\n# Generate unique filename with timestamp\nTIMESTAMP=$(date +%%s)\nFILENAME="task-${TIMESTAMP}-$$.json"\n\n# Write task request to IPC directory\n# The background task watcher will pick this up and start the container\ncat > "/workspace/ipc/tasks/${FILENAME}" << ENDOFFILE\n{\n  "type": "background_task",\n  "agentFolder": "${AGENT}",\n  "name": "${TASK_NAME}",\n  "description": "${TASK_NAME}",\n  "prompt": "${PROMPT}",\n  "notifyOnComplete": true,\n  "notifyJid": "120363422227220717@g.us"\n}\nENDOFFILE\n\necho "[start_task] Background task started: ${TASK_NAME}"\necho "[start_task] Agent: ${AGENT}"\necho "[start_task] Task ID will be generated by the task system"\n' > /usr/local/bin/start_task && chmod +x /usr/local/bin/start_task

# Create delegate_to binary (alias for start_task for backwards compatibility)
RUN printf '#!/bin/bash\n# delegate_to: Delegate a task to another agent\n# Usage: delegate_to <agent> "<prompt>"\n\nif [ $# -lt 2 ]; then\n  echo "Usage: delegate_to <agent> <prompt>"\n  echo "Example: delegate_to nalu \"Review authentication code for security issues\""\n  exit 1\nfi\n\nAGENT="$1"\nPROMPT="$2"\nTASK_NAME="Delegated Task"\n\n# Generate unique filename with timestamp\nTIMESTAMP=$(date +%%s)\nFILENAME="task-${TIMESTAMP}-$$.json"\n\n# Write task request to IPC directory\ncat > "/workspace/ipc/tasks/${FILENAME}" << ENDOFFILE\n{\n  "type": "background_task",\n  "agentFolder": "${AGENT}",\n  "name": "${TASK_NAME}",\n  "description": "${TASK_NAME}",\n  "prompt": "${PROMPT}",\n  "notifyOnComplete": true,\n  "notifyJid": "120363422227220717@g.us"\n}\nENDOFFILE\n\necho "[delegate_to] Task delegated to: ${AGENT}"\necho "[delegate_to] Task ID will be generated by the task system"\n' > /usr/local/bin/delegate_to && chmod +x /usr/local/bin/delegate_to

# Create entrypoint script
# Keep-alive mode: reads from /workspace/ipc/input/_initial.json instead of stdin
# Normal mode: reads from stdin JSON — temp file is deleted immediately after Node reads it
# Follow-up messages arrive via IPC files in /workspace/ipc/input/
RUN printf '#!/bin/bash\nset -e\ncd /app && npx tsc --outDir /tmp/dist 2>&1 >&2\nln -s /app/node_modules /tmp/dist/node_modules\nchmod -R a-w /tmp/dist\nif [ -f /workspace/ipc/input/_initial.json ]; then\n  echo "[entrypoint] Keep-alive mode: using _initial.json"\n  node /tmp/dist/index.js < /dev/null\nelse\n  echo "[entrypoint] Normal mode: reading from stdin"\n  cat > /tmp/input.json\n  node /tmp/dist/index.js < /tmp/input.json\nfi\n' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Set ownership to node user (non-root) for writable directories
RUN chown -R node:node /workspace && chmod 777 /home/node

# Switch to non-root user (required for --dangerously-skip-permissions)
USER node

# Set working directory to group workspace
WORKDIR /workspace/group

# Entry point reads JSON from stdin, outputs JSON to stdout
ENTRYPOINT ["/app/entrypoint.sh"]
